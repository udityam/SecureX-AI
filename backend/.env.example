# ──────────────────────────────────────────────────────────────────────────────
# SecureX AI – Backend Environment Variables
# Copy this file to .env and fill in the values for your environment.
# ──────────────────────────────────────────────────────────────────────────────

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
# Host where Ollama is running. Default is localhost; change if running in
# Docker or on a remote machine.
OLLAMA_HOST=http://localhost:11434

# Which model Ollama should use for threat analysis and bait generation.
# Must be pulled locally: `ollama pull deepseek-r1:7b`
OLLAMA_MODEL=deepseek-r1:7b

# ── Database ──────────────────────────────────────────────────────────────────
# SQLAlchemy connection string. Default uses a local SQLite file.
# For PostgreSQL: postgresql://user:password@host:5432/securex
DATABASE_URL=sqlite:///./securex.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# (Optional) Override the CORS allowed origins list at runtime.
# Comma-separated list added on top of the regex rules already in server.py.
# Example: https://my-app.vercel.app,https://my-app-git-main.vercel.app
# CORS_EXTRA_ORIGINS=
